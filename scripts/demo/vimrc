set nocompatible
set nomodeline
filetype on
syntax on
colorscheme desert
set background=dark
set number
set ruler
set laststatus=2
set showmode
set showcmd
set noswapfile
set nobackup
set nowritebackup
set viminfofile=NONE
set noautoindent
set nosmartindent
set nocindent
set backspace=indent,eol,start
set nowrap
set hlsearch
set incsearch
set ignorecase
set smartcase
set nomore
set noerrorbells
set novisualbell
set t_vb=
set timeoutlen=200
set ttimeoutlen=10
set shortmess=atI
